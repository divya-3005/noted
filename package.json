{
  "name": "noted",
  "version": "1.0.0",
  "description": "A fast, elegant, local-first Markdown workspace engineered for focused thinking and writing.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "test": "node src/main/store.test.js",
    "dist": "electron-builder --mac dmg"
  },
  "keywords": [
    "electron",
    "notes",
    "markdown",
    "joplin",
    "beginner-friendly",
    "desktop-app"
  ],
  "author": "Divya Singh",
  "license": "MIT",
  "build": {
    "appId": "com.divya.noted",
    "productName": "Noted",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "Noted Installer"
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "marked": "^12.0.0"
  }
}
